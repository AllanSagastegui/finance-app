rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid}/receipts/{transactionId}/{fileId} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf')
        && request.resource.metadata.ownerUid == uid;
      allow update: if false;
      allow delete: if owns(uid);
    }

    match /users/{uid}/exports/{fileId} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
