# ─────────────────────────────────────────────────────────────────────────────
android/.gradle/
android/.kotlin/
android/.cxx/
android/local.properties
android/captures/
android/app/debug/
android/app/profile/
android/app/release/
android/app/build/

# ─────────────────────────────────────────────────────────────────────────────
# iOS, Xcode and CocoaPods generated files
# ─────────────────────────────────────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Runner/GeneratedPluginRegistrant.*

# Swift Package Manager local output
.build/
.buildlog/
.swiftpm/

# ─────────────────────────────────────────────────────────────────────────────
# Node.js, TypeScript and Firebase Functions
# ─────────────────────────────────────────────────────────────────────────────
**/node_modules/
*.tsbuildinfo
functions/lib/
functions/.runtimeconfig.json

# ─────────────────────────────────────────────────────────────────────────────
# Firebase CLI and Emulator Suite
# ─────────────────────────────────────────────────────────────────────────────
.firebase/
.firebase-cache/
firebase-export-*/
firebase-data/
emulator-data/

# ─────────────────────────────────────────────────────────────────────────────
# Python tooling used by local scripts
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ─────────────────────────────────────────────────────────────────────────────
# Generated reports and temporary workspace artifacts
# ─────────────────────────────────────────────────────────────────────────────
tmp/
output/

# ─────────────────────────────────────────────────────────────────────────────
# Legacy and migration artifacts
# ─────────────────────────────────────────────────────────────────────────────
.svn/
migrate_working_dir/
