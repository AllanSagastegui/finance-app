# ─────────────────────────────────────────────────────────────────────────────
# Secrets, environment files and signing material
# Keep example files so required variables remain documented.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.p8
*.p12
*.cer
*.mobileprovision
*.jks
*.keystore
key.properties
signing.properties

serviceAccountKey.json
service-account*.json
*-service-account.json
firebase-adminsdk-*.json

# Firebase client configuration is intentionally versioned:
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# ─────────────────────────────────────────────────────────────────────────────
# Flutter, Dart and Pub
# ─────────────────────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/

# Crash symbolication and obfuscation outputs
app.*.symbols
app.*.map.json

# ─────────────────────────────────────────────────────────────────────────────
